{
    "name": "carlbennett/php-plextv-api",
    "description": "A PHP library framework for the Plex.tv API",
    "type": "library",
    "homepage": "https://github.com/carlbennett/php-plextv-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Carl Bennett",
            "email": "carl@carlbennett.me"
        }
    ],
    "config": {
        "vendor-dir": "lib"
    },
    "autoload": {
        "psr-4": {
            "CarlBennett\\PlexTvAPI\\": "src/"
        }
    },
    "require": {
        "ext-curl": "*",
        "ext-xmlreader": "*",
        "php-64bit": ">=8.3",
        "ramsey/uuid": "^4.2"
    },
    "autoload-dev": {
        "psr-4": {
            "CarlBennett\\PlexTvAPI\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1"
    }
}
